{
  "manifest_version": 3,
  "name": "SVG Downloader",
  "version": "1.0",
  "description": "Click to select and download SVG elements from any webpage",
  "permissions": ["activeTab"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
